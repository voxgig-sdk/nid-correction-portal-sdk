# Entity: correction_request

main: kit: entity: correction_request: {

  alias: field: {}

  fields: [
    {
      name: "applicantName"
      req: false
      short: "Name of the applicant"
      type: "`$STRING`"
    }
    {
      name: "category"
      req: false
      short: "Category of correction"
      type: "`$STRING`"
    }
    {
      name: "changes"
      req: false
      short: "List of field changes"
      type: "`$ARRAY`"
    }
    {
      name: "documents"
      req: false
      short: "Supporting documents"
      type: "`$ARRAY`"
    }
    {
      name: "history"
      req: false
      short: "Status change history"
      type: "`$ARRAY`"
    }
    {
      name: "id"
      req: false
      short: "Correction request ID"
      type: "`$STRING`"
    }
    {
      name: "nid"
      req: false
      short: "National ID number"
      type: "`$STRING`"
    }
    {
      name: "notes"
      req: false
      short: "Additional notes"
      type: "`$STRING`"
    }
    {
      name: "source"
      req: false
      short: "Source of the request"
      type: "`$STRING`"
    }
    {
      name: "status"
      req: false
      short: "Current status of the request"
      type: "`$STRING`"
    }
    {
      format: "date-time"
      name: "submittedAt"
      req: false
      short: "Submission timestamp"
      type: "`$STRING`"
    }
    {
      format: "date-time"
      name: "updatedAt"
      req: false
      short: "Last update timestamp"
      type: "`$STRING`"
    }
  ]

  id: {
    field: "id"
    name: "id"
  }

  name: "correction_request"
  op: {
    list: {
      name: "list"
      points: [
        {
          args: {
            query: [
              {
                kind: "query"
                name: "applicant_name"
                orig: "applicant_name"
                reqd: false
                type: "`$STRING`"
              }
              {
                kind: "query"
                name: "category"
                orig: "category"
                reqd: false
                type: "`$STRING`"
              }
              {
                example: 20
                kind: "query"
                name: "limit"
                orig: "limit"
                reqd: false
                type: "`$INTEGER`"
              }
              {
                kind: "query"
                name: "nid"
                orig: "nid"
                reqd: false
                type: "`$STRING`"
              }
              {
                example: 1
                kind: "query"
                name: "page"
                orig: "page"
                reqd: false
                type: "`$INTEGER`"
              }
              {
                kind: "query"
                name: "source"
                orig: "source"
                reqd: false
                type: "`$STRING`"
              }
              {
                kind: "query"
                name: "status"
                orig: "status"
                reqd: false
                type: "`$STRING`"
              }
            ]
          }
          method: "GET"
          orig: "/correction-requests"
          segments: [
            {
              lit: "correction-requests"
            }
          ]
          select: {
            exist: [
              "applicant_name"
              "category"
              "limit"
              "nid"
              "page"
              "source"
              "status"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
    load: {
      name: "load"
      points: [
        {
          args: {
            params: [
              {
                kind: "param"
                name: "id"
                orig: "id"
                reqd: true
                type: "`$STRING`"
              }
            ]
          }
          method: "GET"
          orig: "/correction-requests/{id}"
          segments: [
            {
              lit: "correction-requests"
            }
            {
              var: "id"
            }
          ]
          select: {
            exist: [
              "id"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body.data`"
          }
        }
      ]
    }
  }



}
