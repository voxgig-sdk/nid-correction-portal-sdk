# Entity: authentication

main: kit: entity: authentication: {

  alias: field: {}

  fields: [
    {
      name: "id"
      req: false
      short: "User ID"
      type: "`$STRING`"
    }
    {
      name: "message"
      req: false
      type: "`$STRING`"
    }
    {
      name: "name"
      req: false
      short: "Full name"
      type: "`$STRING`"
    }
    {
      name: "organization"
      req: false
      short: "Organization name"
      type: "`$STRING`"
    }
    {
      name: "otp"
      req: true
      short: "6-digit OTP code"
      type: "`$STRING`"
    }
    {
      name: "password"
      req: true
      short: "User password"
      type: "`$STRING`"
    }
    {
      name: "role"
      req: false
      short: "User role"
      type: "`$STRING`"
    }
    {
      name: "sessionId"
      op: {
        create: {
          req: true
          type: "`$STRING`"
        }
      }
      req: false
      short: "Session identifier for OTP verification"
      type: "`$STRING`"
    }
    {
      name: "success"
      req: false
      type: "`$BOOLEAN`"
    }
    {
      name: "username"
      op: {
        create: {
          req: false
          type: "`$STRING`"
        }
      }
      req: true
      short: "Username or employee ID"
      type: "`$STRING`"
    }
  ]

  id: {
    field: "id"
    name: "id"
  }

  name: "authentication"
  op: {
    create: {
      name: "create"
      points: [
        {
          method: "POST"
          orig: "/auth/login"
          parts: [
            "auth"
            "login"
          ]
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
        {
          method: "POST"
          orig: "/auth/logout"
          parts: [
            "auth"
            "logout"
          ]
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
        {
          method: "POST"
          orig: "/auth/verify-otp"
          parts: [
            "auth"
            "verify-otp"
          ]
          transform: {
            req: "`reqdata`"
            res: "`body.user`"
          }
        }
      ]
    }
  }



}
