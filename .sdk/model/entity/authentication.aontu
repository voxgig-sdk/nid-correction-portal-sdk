# Entity: authentication

main: kit: entity: authentication: {

  alias: field: {}

  fields: {
    message: {
      h: "Message"
      n: "message"
      r: false
      t: "`$STRING`"
    }
    otp: {
      h: "Otp"
      n: "otp"
      r: true
      sh: "6-digit OTP code"
      t: "`$STRING`"
    }
    password: {
      fo: "password"
      h: "Password"
      n: "password"
      r: true
      sh: "User password"
      t: "`$STRING`"
    }
    sessionId: {
      h: "Session Id"
      n: "sessionId"
      op: {
        create: {
          req: true
          type: "`$STRING`"
        }
      }
      r: false
      sh: "Session identifier for OTP verification"
      t: "`$STRING`"
    }
    success: {
      h: "Success"
      n: "success"
      r: false
      t: "`$BOOLEAN`"
    }
    token: {
      h: "Token"
      n: "token"
      r: false
      sh: "JWT authentication token"
      t: "`$STRING`"
    }
    user: {
      h: "User"
      n: "user"
      r: false
      t: "`$OBJECT`"
    }
    username: {
      h: "Username"
      n: "username"
      r: true
      sh: "Username or employee ID"
      t: "`$STRING`"
    }
  }

  name: "authentication"
  op: {
    create: {
      name: "create"
      points: [
        {
          bf: [
            "password"
            "username"
          ]
          co: {
            id: "POST /auth/login"
            source: "openapi3"
            version: 2
          }
          m: "POST"
          o: "/auth/login"
          rs: {
            kind: "json"
            media: "application/json"
          }
          s: [
            {
              lit: "auth"
            }
            {
              lit: "login"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
        {
          co: {
            id: "POST /auth/logout"
            source: "openapi3"
            version: 2
          }
          m: "POST"
          o: "/auth/logout"
          rs: {
            kind: "json"
            media: "application/json"
          }
          s: [
            {
              lit: "auth"
            }
            {
              lit: "logout"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
        {
          bf: [
            "otp"
            "sessionId"
          ]
          co: {
            id: "POST /auth/verify-otp"
            source: "openapi3"
            version: 2
          }
          m: "POST"
          o: "/auth/verify-otp"
          rs: {
            kind: "json"
            media: "application/json"
          }
          s: [
            {
              lit: "auth"
            }
            {
              lit: "verify-otp"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
